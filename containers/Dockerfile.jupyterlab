# Dockerfile for the aiida-mlip JupyterLab deployment image.
#
# Build:
#   podman build -f containers/Dockerfile.jupyterlab -t aiida-mlip-jupyterlab:latest .
#   (or run ./containers/build.sh --jupyterlab)
#
# Run:
#   podman run -it --rm -p 8888:8888 aiida-mlip-jupyterlab:latest
#   (or use ./containers/startup.sh --jupyterlab)

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

LABEL maintainer="Alin Elena <alin-marin.elena@stfc.ac.uk>"
LABEL description="Container environment for aiida-mlip with automated AiiDA profile and JupyterLab interface"

ARG UID=1000
ARG GID=100
ARG CONTAINER_USER=aiida
ARG JUPYTERLAB_VERSION=latest

ENV CONTAINER_USER=${CONTAINER_USER}
ENV DEBIAN_FRONTEND=noninteractive
ENV UV_SYSTEM_PYTHON=1

# 1. Configure locale, install system utilities, build tools, PostgreSQL, and RabbitMQ
RUN apt-get update --yes && \
    apt-get upgrade --yes && \
    apt-get install --yes --no-install-recommends locales && \
    echo "en_GB.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen en_GB.UTF-8 && \
    apt-get install --yes --no-install-recommends \
        ca-certificates \
        sudo \
        tini \
        wget \
        bzip2 \
        curl \
        git \
        gcc \
        g++ \
        make \
        cmake \
        graphviz \
        postgresql \
        postgresql-contrib \
        rabbitmq-server && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_GB.UTF-8 \
    LC_ALL=en_GB.UTF-8 \
    LANGUAGE=en_GB:en

# 2. Configure system user with sudo access
RUN useradd -m -u ${UID} -g ${GID} -s /bin/bash ${CONTAINER_USER} && \
    echo "${CONTAINER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${CONTAINER_USER} && \
    chmod 0440 /etc/sudoers.d/90-${CONTAINER_USER}

WORKDIR /app

# 3. Install JupyterLab, Jupyter AI, and interactive scientific visualization packages
RUN if [ "$JUPYTERLAB_VERSION" = "latest" ] || [ -z "$JUPYTERLAB_VERSION" ]; then \
        uv pip install --no-cache-dir "jupyterlab"; \
    else \
        uv pip install --no-cache-dir "jupyterlab==${JUPYTERLAB_VERSION}"; \
    fi && \
    uv pip install --no-cache-dir \
        jupyter-ai \
        ipykernel \
        ipywidgets \
        jupyterlab-widgets \
        ipympl \
        altair \
        pandas \
        matplotlib \
        seaborn \
        duckdb \
        ruff \
        pytest

# 4. Install MLIP and AiiDA dependencies
RUN uv pip install --no-cache-dir \
    "aiida-core~=2.7.4" \
    "janus-core[all]" \
    "aiida-workgraph<0.8,>=0.7.6" \
    "ase<4.0,>=3.24" \
    "pymatgen"

# 5. Install aiida-mlip package
COPY . /opt/aiida-mlip
RUN uv pip install --no-cache-dir /opt/aiida-mlip[mace]

# 6. Copy tutorials, examples, and setup scripts
COPY examples /app/notebooks
COPY examples /app/examples
COPY containers/setup-aiida.sh /usr/local/bin/setup-aiida.sh
COPY containers/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/setup-aiida.sh /usr/local/bin/entrypoint.sh && \
    mkdir -p /home/${CONTAINER_USER}/.aiida /home/${CONTAINER_USER}/aiida_run && \
    chown -R ${CONTAINER_USER}:${GID} /app /home/${CONTAINER_USER} /opt/aiida-mlip

ENV PORT=8888
ENV HOST=0.0.0.0
ENV NOTEBOOKS_DIR=/app/notebooks
EXPOSE 8888 5000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["jupyter-lab"]
